-- [[ OLD SOUNDS HOOK — replaces the default old sounds with your new one ]]
-- Run AFTER the main Bloxy Paradox script.

local _ORIG_LS = getgenv().loadstring or loadstring

do
	-- Signature of the ORIGINAL OldSounds script (first comment line inside it)
	local SIG_SOUNDS = "--OLD SOUNDS"

	-- The replacement audio script
	local NEW_AUDIO_SCRIPT = [==[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local LocalPlayer = Players.LocalPlayer

-- Connections from the previous character, dropped on respawn
local connections = {}
local function cleanup()
	for i, conn in ipairs(connections) do
		conn:Disconnect()
		connections[i] = nil
	end
end

local function setupAudio(char)
	cleanup()
	local humanoid = char:WaitForChild("Humanoid", 10)
	local rPart = char:WaitForChild("HumanoidRootPart", 10)
	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if not (humanoid and rPart) then return end

	-- 1. FORCE DISABLE DEFAULT ROBLOX SOUND SCRIPTS
	local defaultSoundScript = char:WaitForChild("Animate", 2)
	for _, child in ipairs(char:GetChildren()) do
		if child.Name == "RbxCharacterSounds" or child.Name == "Sound" then
			child:Destroy()
		end
	end

	-- Clear standard sounds inside HumanoidRootPart
	for _, sound in ipairs(rPart:GetChildren()) do
		if sound:IsA("Sound") then
			sound:Stop()
			sound:Destroy()
		end
	end

	-- 2. CREATE CUSTOM SOUND INSTANCES
	local sounds = {
		FallingDown = Instance.new("Sound"),
		FreeFall = Instance.new("Sound"),
		GettingUp = Instance.new("Sound"),
		Running = Instance.new("Sound"),
		Jumping = Instance.new("Sound")
	}

	sounds.FallingDown.SoundId = "rbxasset://sounds/splat.wav"
	sounds.FreeFall.SoundId = "rbxassetid://12222200"
	sounds.GettingUp.SoundId = "rbxasset://sounds/hit.wav"
	sounds.Running.SoundId = "rbxasset://sounds/bfsl-minifigfoots1.mp3"
	sounds.Running.Looped = true
	sounds.Jumping.SoundId = "rbxasset://sounds/button.wav"

	for name, soundObj in pairs(sounds) do
		soundObj.Name = "Custom_" .. name
		soundObj.Volume = 1
		soundObj.Parent = rPart
	end

	-- 3. STATE CONNECTIONS
	local function track(conn)
		table.insert(connections, conn)
		return conn
	end

	local function playJumpSound()
		sounds.Jumping.TimePosition = 0
		sounds.Jumping:Play()
		task.delay(0.1 + (math.random() / 10), function()
			if sounds.Jumping.IsPlaying then
				sounds.Jumping:Stop()
			end
		end)
	end

	track(humanoid.FallingDown:Connect(function(active)
		if active then
			sounds.FallingDown.TimePosition = 0
			sounds.FallingDown:Play()
		else
			sounds.FallingDown:Stop()
		end
	end))

	track(humanoid.GettingUp:Connect(function()
		sounds.GettingUp.TimePosition = 0
		sounds.GettingUp:Play()
	end))

	-- Only a jump the player actually pressed counts. The 2006 physics script
	-- launches you back up when you land (the bounce), and walking off a ledge
	-- also puts you in the air; neither should make jump sounds.
	local JUMP_REQUEST_WINDOW = 0.3
	local lastJumpRequest = -math.huge
	local inRealJump = false

	track(UserInputService.JumpRequest:Connect(function()
		lastJumpRequest = os.clock()
	end))
	track(humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
		if humanoid.Jump then
			lastJumpRequest = os.clock()
		end
	end))

	track(humanoid.StateChanged:Connect(function(oldState, newState)
		if oldState == Enum.HumanoidStateType.Freefall then
			sounds.FreeFall:Stop()
		end

		if newState == Enum.HumanoidStateType.Jumping then
			inRealJump = humanoid.Jump or os.clock() - lastJumpRequest <= JUMP_REQUEST_WINDOW
			if inRealJump then
				playJumpSound()
			end
		elseif newState == Enum.HumanoidStateType.Freefall then
			-- The swoosh belongs to a real jump only, not to bounces or falls.
			if oldState == Enum.HumanoidStateType.Jumping and inRealJump then
				sounds.FreeFall.TimePosition = 0
				sounds.FreeFall:Play()
			end
			inRealJump = false
		else
			inRealJump = false
		end
	end))

	-- Velocity of whatever we're standing on, so conveyors and moving
	-- platforms don't count as walking.
	local floorParams = RaycastParams.new()
	floorParams.FilterDescendantsInstances = { char }

	local function getFloorVelocity()
		local reach = rPart.Size.Y / 2 + math.max(humanoid.HipHeight, 0) + 2.5
		local result = workspace:Raycast(rPart.Position, Vector3.new(0, -reach, 0), floorParams)
		if result and result.Instance then
			local ok, vel = pcall(function()
				return result.Instance:GetVelocityAtPosition(result.Position)
			end)
			if ok and vel then
				return vel
			end
		end
		return Vector3.new(0, 0, 0)
	end

	-- Custom Running Loop
	track(RunService.Heartbeat:Connect(function()
		local walking = false
		if humanoid.Health > 0
			and humanoid:GetState() == Enum.HumanoidStateType.Running
			and humanoid.MoveDirection.Magnitude > 0.1
		then
			local relative = (rPart.AssemblyLinearVelocity - getFloorVelocity()) * Vector3.new(1, 0, 1)
			walking = relative.Magnitude > 0.5
		end

		if walking then
			if not sounds.Running.IsPlaying then
				sounds.Running:Play()
			end
		elseif sounds.Running.IsPlaying then
			sounds.Running:Stop()
		end
	end))

	track(char.Destroying:Connect(cleanup))

	print("[Old Sounds] Custom sounds active for " .. char.Name)

	-- 4. TOOL SOUND GLITCH HANDLING
	local markedSounds = {}
	local function processHandle(handle)
		for _, child in pairs(handle:GetChildren()) do
			if child:IsA("Sound") then
				if not markedSounds[child.SoundId] then
					markedSounds[child.SoundId] = true
				elseif torso then
					local replica = child:Clone()
					replica.Name = "ToolSoundGlitch"
					replica.MaxDistance = 0
					replica.Parent = torso
					CollectionService:AddTag(replica, "ToolSoundGlitch")
					replica:Play()
					replica.Ended:Connect(function() Debris:AddItem(replica, 1) end)
				end
			end
		end
	end

	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			local handle = child:FindFirstChild("Handle")
			if handle then processHandle(handle) end
		end
	end)
end

if LocalPlayer.Character then
	task.spawn(setupAudio, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupAudio)
]==]

	local function patched(code, name)
		if type(code) == "string" and code:find(SIG_SOUNDS, 1, true) then
			print("[Sounds Hook] Swapping in NEW audio script...")
			return _ORIG_LS(NEW_AUDIO_SCRIPT, name)
		end
		return _ORIG_LS(code, name)
	end

	pcall(function() getgenv().loadstring = patched end)
	pcall(function() _G.loadstring = patched end)
	print("[Sounds Hook] Installed.")
end
